<resources>
    <!-- Device-specific array of SIM slot indexes which are embedded eUICCs.
         The second slot is the built-in one; config_num_physical_slots stays at
         the 2 that sm8450-common already sets. -->
    <integer-array name="non_removable_euicc_slots">
        <item>1</item>
    </integer-array>

    <!-- Capabilities the eUICC reports to the carrier during profile download. -->
    <string-array name="config_telephonyEuiccDeviceCapabilities">
        <item>gsm,8</item>
        <item>utran,9</item>
        <item>eutran,15</item>
    </string-array>
</resources>
